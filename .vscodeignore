.vscode/**
.vscode-test/**
.git/**
.gitignore
.vscodeignore

# development only
test/**
scripts/**
src/languages/README.md

# build outputs and sources of assets
*.vsix
images/icon.svg

# misc
node_modules/**
**/*.map
**/.DS_Store
**/Thumbs.db
